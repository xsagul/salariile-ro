# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code worktrees + state
.claude

# typescript
*.tsbuildinfo
next-env.d.ts

# audit surse (cărți locale, sub copyright) + log server local
/_books
.serverlog-*.txt

# Unealtă locală de validare D112 (nu se deployează)
/_d112-local

# Cheie service account Google Search Console (NU se commit-ează)
gsc-key.json
/.gsc/

# Snapshoturi de trafic + rapoarte de audit SEO.
# Repo-ul este public: datele GSC/Vercel defalcate pe pagini și profilul de
# backlinkuri rămân locale. Vezi PROGRES.md pentru concluziile publicabile.
/seo-snapshots/
/seo-assets/
/SEO-AUDIT-*.md

# Iesirile scripturilor de audit: se regenereaza oricand cu `node scripts/audit-*.mjs`
# si contin defalcari GSC pe pagini, care nu se publica.
/.audit-*.json
/.gsc-*.json

# Cercetare despre competitori: ramane LOCALA.
# Repo-ul e public, deci orice analiza a defectelor concurentei publicata aici
# devine, de fapt, un material public despre ei — exact ce am decis ca nu facem.
/.cercetare-privata/

# Analiza de audienta si golul fata de competitori — RAMAN LOCALE.
# Aceeasi ratiune ca la /.cercetare-privata/ si /SEO-AUDIT-*.md de mai sus:
# contin defalcari GSC pe interogari si pozitiile competitorilor, exportate
# dintr-un tool platit. Concluziile publicabile stau in PROGRES.md.
/AUDIENTA-MASURATA-*.md
/GOL-KEYWORDS-*.md
/ACOPERIRE-PAYLAB-*.txt
/PLAN-12-LUNI-*.md
/research/paylab-keywords-*.csv
/scripts/analiza-gol-paylab.mjs
/scripts/audit-acoperire-paylab.mjs
# Chestionarul de brand contine raspunsuri strategice si intrebari personale
# adresate proprietarului. Ramane local; din el se scrie sectiunea de audienta
# din BRAND.md, care e publicabila.
/CHESTIONAR-BRAND.md
# Verificarea surselor contine decizii interne inca neanuntate.
/VERIFICARI-SURSE-SALARII-*.md

# Arhiva Umami: date de trafic defalcate pe pagini, sesiuni si interogari.
# Aceeasi ratiune ca la /seo-snapshots/ si /AUDIENTA-MASURATA-*.md de mai sus —
# repo-ul e public. Concluziile publicabile se muta in PROGRES.md.
/export-umami/
/.env.umami
